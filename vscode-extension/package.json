{
  "name": "sm6-to-sm5-shader-lab",
  "displayName": "SM6 to SM5 Shader Lab",
  "description": "Dashboard VS Code per analizzare shader SM6/SM5 e ispezionare catture PIX tramite il server MCP",
  "version": "0.1.2",
  "publisher": "local-tools",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:sm6ToSm5.dashboard",
    "onView:sm6ToSm5.pix",
    "onCommand:sm6ToSm5.openDashboard",
    "onCommand:sm6ToSm5.configureMcp",
    "onCommand:sm6ToSm5.configurePixTools"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sm6ToSm5.openDashboard",
        "title": "SM6 to SM5: Apri Shader Lab",
        "category": "SM6 to SM5"
      },
      {
        "command": "sm6ToSm5.configureMcp",
        "title": "SM6 to SM5: Configura server MCP VS Code",
        "category": "SM6 to SM5"
      },
      {
        "command": "sm6ToSm5.configurePixTools",
        "title": "SM6 to SM5: Configura eseguibili PIX",
        "category": "SM6 to SM5"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sm6ToSm5",
          "title": "Shader Lab",
          "icon": "media/shader-lab.svg"
        }
      ]
    },
    "views": {
      "sm6ToSm5": [
        {
          "type": "webview",
          "id": "sm6ToSm5.dashboard",
          "name": "SM6 to SM5"
        },
        {
          "type": "webview",
          "id": "sm6ToSm5.pix",
          "name": "Cattura PIX"
        }
      ]
    }
  }
}
